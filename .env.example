# Copy this file to .env.local and fill it in.
# With the two Supabase values left empty the app runs in demo mode on
# in-memory mock data, with one-click demo accounts on the sign-in page.

# Supabase project (Project Settings -> API). The anon key is safe in the browser;
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email domain students must sign up with, without the "@". Server-side only.
# Optional: it already defaults to mitwpu.edu.in (lib/constants/site.ts).
# If you change it, change public.college_email_domain() in the database too.
COLLEGE_EMAIL_DOMAIN=mitwpu.edu.in

# Public URL of the site, used in confirmation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant chatbot (optional). Without a key the assistant still works, but it
# only lists matching experiences instead of writing an answer.
# Groq is the main model: free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pick a different Groq model (see console.groq.com/docs/models).
# GROQ_MODEL=openai/gpt-oss-20b
# Gemini is the fallback when Groq is unavailable: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Both keys are read on the server only. Never prefix them with NEXT_PUBLIC_.

# Semantic search and insights. Embeddings come from Gemini, so GEMINI_API_KEY
# above is what turns them on; without it the assistant falls back to keyword
# retrieval and experiences keep their plain view.
# Optional: a different embedding model. Its width must match the vector(768)
# column in supabase/migrations/0002_search_insights_votes.sql -- change one and
# you must change the other, then re-embed every experience from the admin page.
# GEMINI_EMBED_MODEL=text-embedding-004

# Never put the Supabase service-role key in this project. It is not needed.
